                    uniform double mjc:damping = 0.5
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.5
            uniform double mjc:torsionalfriction = 0.5
        }

        def MjcActuator "fl_hip"
        {
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 1
            uniform double mjc:ctrlRange:min = -1
            uniform double[] mjc:gear = [8, 0, 0, 0, 0, 0]
            custom rel mjc:target
            prepend rel mjc:target = </oddling/Geometry/torso/fl_hip/fl_hip>
