    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "oddling"
{
    over "Geometry"
    {
        over "torso"
        {
            over "torso" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
            }

            over "mouth"
            {
                over "mouth_bulb" (
                    prepend apiSchemas = ["MjcCollisionAPI"]
                )
                {
                }

                over "PhysicsFixedJoint"
                {
                }
            }

            over "fl_hip"
            {
                over "Capsule" (
                    prepend apiSchemas = ["MjcCollisionAPI"]
                )
                {
                }

                over "fl_shin"
                {
                    over "Capsule" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                    }

                    over "fl_knee" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:armature = 0.01
                        uniform double mjc:damping = 0.5
                    }
                }

                over "fl_hip" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:armature = 0.01
                    uniform double mjc:damping = 0.5
                }
            }

