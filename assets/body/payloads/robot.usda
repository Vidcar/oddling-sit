over "oddling" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "torso" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "mouth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "fl_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "fl_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }
            }

            over "fr_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "fr_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }
            }

            over "hl_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hl_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hl_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hl_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }
            }

            over "hr_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hr_hip" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hr_shin" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hr_knee" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }
            }
        }
    }
}

